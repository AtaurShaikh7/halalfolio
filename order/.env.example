# Copy to order/.env and fill in. order/.env is gitignored — NEVER commit real values.
# Personal use only — your own Angel One account.

ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
# TOTP *secret* (the base32 string shown when you enable TOTP), NOT a 6-digit code.
# place.mjs generates the live 6-digit code from this at runtime via otplib.
ANGEL_TOTP_SECRET=
# The static IP you registered under SmartAPI dashboard → your app → Primary Static IP.
# Orders from other IPs are rejected by Angel.
ANGEL_STATIC_IP=
